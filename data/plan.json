{
"v": 1,
"name": "Market power reading plan",
"note": "610 must-read papers (569 from the bibliography plus 41 foundations) in 14 phases, in study order.",
"depth": {
"deep": "Deep · about 5 h: rebuild the model, reproduce a result",
"std": "Standard · about 2 h: intro, main model or table, conclusion",
"skim": "Skim · about 30 min: abstract, intro, conclusion"
},
"phases": [
{
"title": "Orientation",
"about": "Get the map of the field before the details.",
"task": "Write a one-page glossary: Lerner index, conduct parameter, HHI, markup, markdown, foreclosure, contestability."
},
{
"title": "Foundations of imperfect competition",
"about": "Monopoly, monopolistic competition and the debates of the 1920s–50s.",
"task": "Derive the Cournot, Bertrand and Hotelling equilibria from scratch, then explain in a paragraph why Bertrand with identical firms gives P = MC."
},
{
"title": "Oligopoly and strategic behavior",
"about": "Commitment, entry deterrence, predation, product differentiation.",
"task": "Solve Dixit (1979) on paper: when does the incumbent deter, accommodate or blockade entry?"
},
{
"title": "Collusion and cartels",
"about": "Repeated games, cartel stability, detection, leniency.",
"task": "Compute the critical discount factor for collusion under Bertrand and under Cournot trigger strategies. Then read a cartel case decision and spot the facilitating practices."
},
{
"title": "Measuring market power",
"about": "SCP regressions, then demand estimation, production functions and markups.",
"task": "Estimate logit and random-coefficients demand on the pyblp tutorial data, recover markups, and compare them with a production-function markup."
},
{
"title": "Pricing strategies",
"about": "Price discrimination, screening, bundling, durable goods.",
"task": "Solve the two-type Mussa–Rosen model and show the 'no distortion at the top' result."
},
{
"title": "Vertical relations and exclusion",
"about": "Double marginalization, restraints, foreclosure, bargaining.",
"task": "Work a double-marginalization numerical example, then write a one-page memo for or against a real vertical merger."
},
{
"title": "Mergers and antitrust",
"about": "Merger theory, simulation, retrospectives, market definition, enforcement.",
"task": "Compute UPP and GUPPI for a hypothetical merger with given diversion ratios and margins, then write a two-page mock merger review."
},
{
"title": "Innovation, networks and platforms",
"about": "Schumpeter vs Arrow, patents, network effects, two-sided markets, Big Tech.",
"task": "Write a two-page essay: does platform market power slow innovation? Cite at least eight papers from this phase on both sides."
},
{
"title": "Natural monopoly and regulation",
"about": "Cost tests, Ramsey pricing, incentive regulation, capture.",
"task": "Solve the two-type Baron–Myerson model and explain the information-rent / efficiency trade-off in plain words."
},
{
"title": "Welfare, political economy and macro",
"about": "Deadweight loss, rent-seeking, rising markups, labor share.",
"task": "Redo Harberger's back-of-envelope with modern markup estimates (De Loecker–Eeckhout–Unger) and explain why the answers differ so much."
},
{
"title": "Labor market power",
"about": "Monopsony, wage-setting, concentration, minimum wages.",
"task": "Derive the monopsony markdown w/MRPL = ε/(1+ε) and compute it for the elasticities in Sokolova–Sorensen."
},
{
"title": "Trade and development",
"about": "Strategic trade, pro-competitive gains, markets in poor countries.",
"task": "Explain in one page how trade liberalization changes markups, using two papers from this phase."
},
{
"title": "Applied fields",
"about": "Health, finance, economic history, media, sports.",
"task": "Pick one field and write a three-page literature review. This is the seed of a thesis or research project."
}
],
